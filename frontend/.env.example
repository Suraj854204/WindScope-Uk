# Base URL of the WindScope API as seen by the BROWSER (no trailing slash).
# Leave empty to use same-origin /api (Vite dev proxy locally, nginx proxy in Docker).
# Example for Vercel + a separately hosted backend: https://windscope-api.onrender.com
VITE_API_BASE_URL=

# Dev server only: where Vite proxies /api (default http://localhost:8000)
VITE_DEV_PROXY_TARGET=http://localhost:8000
